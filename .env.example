# ─── AWS (Production) ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=pippit-creation-assets
# Leave empty in production to use real AWS S3
S3_ENDPOINT=
CLOUDFRONT_DOMAIN=https://XXXXXXXXXXXX.cloudfront.net

# ─── MinIO (Local Dev — set automatically by docker-compose.yml) ────────────
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET_NAME=pippit-assets
# CLOUDFRONT_DOMAIN=http://localhost:9000/pippit-assets

# ─── Database ────────────────────────────────────────────────────────────────
# Neon (Production):
DATABASE_URL=postgresql://user:password@host/pippit?sslmode=require
# Local Docker (Dev):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pippit

# ─── Redis ───────────────────────────────────────────────────────────────────
# Upstash / Redis Cloud (Production):
REDIS_URL=rediss://default:password@host:6379
# Local Docker (Dev):
# REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ─── Next.js (prefix with NEXT_PUBLIC_ to expose to browser) ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=http://localhost:9000/pippit-assets
